{
  "name": "openrts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:web": "tsc --noEmit && vite build --config vite.web.config.ts",
    "preview:web": "vite preview --outDir dist-web",
    "server:build": "esbuild server/main.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=server/dist/main.mjs",
    "server": "npm run server:build && node server/dist/main.mjs",
    "server:check": "tsc -p server/tsconfig.json --noEmit",
    "test:handling": "node test/handling.mjs",
    "test:human": "node test/humanFaction.mjs",
    "verify:human": "npm run build && npm run test:human",
    "test:animation": "node test/animationLogic.mjs && node test/animationCoverage.mjs",
    "verify:animation": "npm run build && npm run test:animation",
    "test:rooms": "node test/customRooms.mjs",
    "test:tower-vision": "node test/towerVision.mjs",
    "test:custom-game": "node test/customGameUi.mjs"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "ws": "^8.21.3"
  }
}
